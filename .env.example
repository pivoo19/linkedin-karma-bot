# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here

# Database URL
# For development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./karma_bot.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/karma_bot

# Default settings
DEFAULT_LANGUAGE=ru
DEFAULT_KARMA_PERIOD=7
DEFAULT_VETERAN_THRESHOLD=30
DEFAULT_POST_COST=0
